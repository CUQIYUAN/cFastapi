{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cfastapi",
	"main": "src/main.py",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["python_workers"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application", // SPA 支持
		"run_worker_first": ["/api/*"]
	},
}